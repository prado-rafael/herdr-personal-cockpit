{
  "name": "herdr-personal-cockpit",
  "version": "0.0.0",
  "private": true,
  "description": "Tests for the Personal Cockpit mod. Not shipped: the installers copy mods/personal-cockpit and layouts/ only.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "test": "node --import ./tests/support/register.mjs --test",
    "coverage": "node --import ./tests/support/register.mjs --test --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-exclude=\"tools/**\" --test-coverage-lines=98 --test-coverage-branches=92 --test-coverage-functions=86",
    "coverage:dir": "node --input-type=commonjs -e \"require('node:fs').mkdirSync('coverage',{recursive:true})\"",
    "coverage:lcov": "npm run coverage:dir && node --import ./tests/support/register.mjs --test --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-exclude=\"tools/**\" --test-coverage-lines=98 --test-coverage-branches=92 --test-coverage-functions=86 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info"
  }
}
